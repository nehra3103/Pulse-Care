# Server
PORT=5050

# Gemini / Google AI (optional; rule-based fallbacks are used if absent)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# SMTP email (optional; a Nodemailer test transport is attempted if absent)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
